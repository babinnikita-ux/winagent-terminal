{
  "appId": "io.winagent.terminal",
  "productName": "WinAgent Terminal",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/*.ts",
    "!**/*.tsx",
    "!src/**/*",
    "!docs/**/*",
    "!tests/**/*"
  ],
  "asarUnpack": [
    "node_modules/node-pty/prebuilds/**"
  ],
  "win": {
    "signtoolOptions": { "publisherName": ["SignPath Foundation"] },
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WinAgent Terminal",
    "artifactName": "winagent-terminal-${version}-setup.${ext}"
  },
  "portable": {
    "artifactName": "winagent-terminal-${version}-portable.exe"
  },
  "extraResources": [
    { "from": "resources/themes", "to": "themes" },
    { "from": "resources/sounds", "to": "sounds" },
    { "from": "resources/claude-instructions.md", "to": "claude-instructions/claude-instructions.md" },
    { "from": "src/shell-integration", "to": "shell-integration" },
    { "from": "dist/cli/wmux.js", "to": "cli/wmux.js" },
    { "from": "dist/cli/wagent.js", "to": "cli/wagent.js" },
    { "from": "dist/cli/wmux-hook.js", "to": "cli/wmux-hook.js" },
    { "from": "src/cli-bin", "to": "cli-bin" },
    { "from": "resources/wmux-orchestrator", "to": "wmux-orchestrator" }
  ]
}
